{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "db:provision": "NODE_ENV=development DB_CONNECTION_MODE=admin bun --env-file=.env scripts/provision-app-role.ts",
    "db:test:provision": "NODE_ENV=test DB_CONNECTION_MODE=admin bun --env-file=.env.test scripts/provision-app-role.ts",
    "db:migrate": "DB_CONNECTION_MODE=admin bunx mikro-orm migration:up",
    "db:migration:pending": "DB_CONNECTION_MODE=admin bunx mikro-orm migration:pending",
    "db:migration:create": "DB_CONNECTION_MODE=admin bunx mikro-orm migration:create",
    "db:test:migrate": "NODE_ENV=test DB_CONNECTION_MODE=admin bun --env-file=.env.test scripts/migrate-test.ts",
    "test:integration": "NODE_ENV=test DB_CONNECTION_MODE=app bun --env-file=.env.test test tests/integration",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "bun dist/main.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint src tests scripts",
    "sqs:setup": "bun --env-file=.env scripts/setup-sqs.ts",
    "sqs:smoke": "bun --env-file=.env scripts/smoke-sqs.ts",
    "worker:sqs": "DB_CONNECTION_MODE=app bun --env-file=.env scripts/consume-sqs-wagers.ts",
    "sqs:send-demo": "bun --env-file=.env scripts/send-sqs-demo.ts",
    "worker:outbox": "DB_CONNECTION_MODE=app bun --env-file=.env scripts/publish-outbox.ts",
    "sqs:results": "bun --env-file=.env scripts/read-sqs-results.ts",
    "ops:status": "DB_CONNECTION_MODE=app bun --env-file=.env scripts/ops-status.ts",
    "sqs:heartbeat": "bun --env-file=.env.test scripts/smoke-sqs-heartbeat.ts",
    "ops:audit": "DB_CONNECTION_MODE=app bun --env-file=.env scripts/audit-financial-integrity.ts",
    "ops:test:audit": "NODE_ENV=test DB_CONNECTION_MODE=app bun --env-file=.env.test scripts/audit-financial-integrity.ts",
    "test:e2e": "NODE_ENV=test DB_CONNECTION_MODE=app bun --env-file=.env.test scripts/e2e-distributed-wager.ts",
    "ops:test:status": "NODE_ENV=test DB_CONNECTION_MODE=app bun --env-file=.env.test scripts/ops-status.ts",
    "sqs:resilience": "NODE_ENV=test DB_CONNECTION_MODE=app bun --env-file=.env.test scripts/smoke-sqs-resilience.ts",
    "worker:references": "DB_CONNECTION_MODE=app bun --env-file=.env scripts/process-pending-references.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mikro-orm/cli": "^7.2.5",
    "@nestjs/cli": "^12.0.8",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1"
  }
}
